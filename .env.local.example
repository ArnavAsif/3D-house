# ============================================================================
# VILLA LUMINA 3D SHOWROOM - CUSTOM COMMERCE ENVIRONMENT CONFIGURATION
# ============================================================================

# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-Only Secret (NEVER exposed to the browser)
# Used only by Next.js Server Actions and API Route Handlers
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Custom Storefront Configuration
NEXT_PUBLIC_STORE_NAME=Villa Lumina Atelier
NEXT_PUBLIC_SITE_URL=http://localhost:3000
